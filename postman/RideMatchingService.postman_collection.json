    {
      "name": "3.1 Get Nearest Drivers",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Response has drivers array\", function () {",
              "    const json = pm.response.json();",
              "    pm.expect(json).to.have.property(\"drivers\");",
              "    pm.expect(json.drivers).to.be.an(\"array\");",
              "});",
              "pm.test(\"Exactly 2 drivers returned (driver 30 excluded)\", function () {",
              "    const json = pm.response.json();",
              "    pm.expect(json.drivers).to.have.lengthOf(2);",
              "});",
              "pm.test(\"Driver IDs are 10 and 20\", function () {",
              "    const json = pm.response.json();",
              "    const ids = json.drivers.map(d => d.driverId);",
              "    pm.expect(ids).to.include(10);",
              "    pm.expect(ids).to.include(20);",
              "    pm.expect(ids).to.not.include(30);",
              "});",
              "pm.test(\"Nearest driver entries have no available field\", function () {",
              "    const json = pm.response.json();",
              "    json.drivers.forEach(d => {",
              "        pm.expect(d).to.not.have.property(\"available\");",
              "    });",
              "});",
              "pm.test(\"Driver 10 is closer than Driver 20 (distance check)\", function () {",
              "    const json = pm.response.json();",
              "    const d10 = json.drivers.find(d => d.driverId === 10);",
              "    const d20 = json.drivers.find(d => d.driverId === 20);",
              "    pm.expect(d10.distance).to.eql(d20.distance); // both at distance 1 from origin",
              "});"
            ]
          }
        }
      ],
