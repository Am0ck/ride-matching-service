              "    pm.collectionVariables.set(\"rideId1\", String(json.rideId));",
              "});",
              "pm.test(\"Ride status is ACTIVE\", function () {",
              "    const json = pm.response.json();",
              "    pm.expect(json.status).to.eql(\"ACTIVE\");",
              "});",
              "pm.test(\"pickupLocation is correct\", function () {",
              "    const json = pm.response.json();",
              "    pm.expect(json.pickupLocation.x).to.eql(0);",
              "    pm.expect(json.pickupLocation.y).to.eql(0);",
              "});",
              "pm.test(\"Assigned driver has driverId\", function () {",
              "    const json = pm.response.json();",
              "    pm.expect(json.driver).to.have.property(\"driverId\");",
              "});",
              "pm.test(\"Assigned driver is Driver 10 (nearest available)\", function () {",
              "    const json = pm.response.json();",
              "    pm.expect(json.driver.driverId).to.eql(10);",
              "});",
              "pm.test(\"Assigned driver is unavailable after allocation\", function () {",
              "    const json = pm.response.json();",
              "    pm.expect(json.driver.available).to.be.false;",
              "});"
            ]
          }
        }
