    {
      "name": "10.1 Complete Ride 1",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Response has matching rideId\", function () {",
              "    const json = pm.response.json();",
              "    pm.expect(json.rideId)",
              "        .to.eql(Number(pm.collectionVariables.get(\"rideId1\")));",
              "});",
              "pm.test(\"Ride status is COMPLETED\", function () {",
              "    const json = pm.response.json();",
              "    pm.expect(json.status).to.eql(\"COMPLETED\");",
              "});",
              "pm.test(\"Response has pickupLocation\", function () {",
              "    const json = pm.response.json();",
              "    pm.expect(json).to.have.property(\"pickupLocation\");",
              "});",
              "pm.test(\"Response has nested driver object\", function () {",
